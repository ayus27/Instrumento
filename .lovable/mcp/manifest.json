{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qkgvocolnvajgusupukz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "playable-instruments",
      "version": "0.1.0",
      "title": "Playable Instruments"
    },
    "tools": [
      {
        "name": "list_instruments",
        "title": "List instruments",
        "description": "List the playable instruments available in Instrumento, with their routes and types.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_tuning",
        "title": "Get standard tuning",
        "description": "Get the standard tuning for guitar or ukulele, including each string's note name and target frequency in Hz.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "instrument": {
              "type": "string",
              "enum": [
                "guitar",
                "ukulele"
              ],
              "description": "Which fretted instrument to tune."
            }
          },
          "required": [
            "instrument"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "note_frequency",
        "title": "Note frequency",
        "description": "Convert a note name (e.g. A4, C#3) to its MIDI number and frequency in Hz, optionally comparing a measured frequency in cents.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "Note name with octave, e.g. 'A4' or 'F#2'."
            },
            "measuredHz": {
              "description": "Optional measured frequency to compare against the target note.",
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "note"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
